name: Slack Issue label Automation

on:
  issues:
    types: [opened]

jobs:
  automate:
    runs-on: ubuntu-latest
    if: contains(github.event.issue.body, 'Reported via Slack workflow') # only Slack tickets

    steps:
      # Add label
      - name: Add label
        uses: actions-ecosystem/action-add-labels@v1
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          issue_number: ${{ github.event.issue.number }}
          labels: slack-ticket
